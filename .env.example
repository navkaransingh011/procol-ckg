# Copy to .env and fill in. .env is gitignored.
CKG_DATABASE_URL=postgres://localhost/ckg
KB_DATABASE_URL=postgres://localhost/procol_knowledge_base

# Provider is configuration, not code — any OpenAI-compatible endpoint works.
#   Slingring (internal):  http://slingring.procol.tech/v1   (http, not https)
#   Ollama (local, free):  http://localhost:11434/v1
#   Mock (no model/key):   mock
LLM_BASE_URL=http://slingring.procol.tech/v1
LLM_MODEL=FAST_SMALLER
LLM_API_KEY=
LLM_MODE=guided

# Sign-in and roles (docs/AUTH.md). Email + password accounts live in ckg.users: npm run users -- add <email> <role>.
# Roles: config/roles.json. Google sign-in is deferred until the VM has a hostname with TLS.
CKG_ALLOWED_DOMAIN=procol.in
CKG_SESSION_DAYS=14
CKG_COOKIE_SECURE=0

# Saved chats: how long the replay events of a turn are kept (question and answer text are kept for ever).
CKG_CHAT_RETENTION_DAYS=180
