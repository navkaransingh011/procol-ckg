# Copy to .env and fill in. .env is gitignored.
CKG_DATABASE_URL=postgres://localhost/ckg
KB_DATABASE_URL=postgres://localhost/procol_knowledge_base

# Provider is configuration, not code — any OpenAI-compatible endpoint works.
#   Slingring (internal):  http://slingring.procol.tech/v1   (http, not https)
#   Ollama (local, free):  http://localhost:11434/v1
#   Mock (no model/key):   mock
LLM_BASE_URL=http://slingring.procol.tech/v1
LLM_MODEL=FAST_SMALLER
LLM_API_KEY=
LLM_MODE=guided
