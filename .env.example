# Copy to .env and fill in. .env is gitignored.
CKG_DATABASE_URL=postgres://localhost/ckg
KB_DATABASE_URL=postgres://localhost/procol_knowledge_base

# Provider is configuration, not code — any OpenAI-compatible endpoint works.
#   Slingring (internal):  http://slingring.procol.tech/v1   (http, not https)
#   Ollama (local, free):  http://localhost:11434/v1
#   Mock (no model/key):   mock
LLM_BASE_URL=http://slingring.procol.tech/v1
LLM_MODEL=FAST_SMALLER
LLM_API_KEY=
LLM_MODE=guided

# Indexing endpoint (src/index-service.mjs, deploy/ckg-index.service). Only the VM needs these.
# INDEX_WEBHOOK_SECRET is shared with each source repo as its CKG_INDEX_SECRET; generate with
#   openssl rand -hex 32
# The service refuses to start without it. Keep INDEX_HOST on loopback: CI reaches it through an
# SSH port-forward over IAP, so the port is never exposed.
INDEX_WEBHOOK_SECRET=
INDEX_HOST=127.0.0.1
INDEX_PORT=8788
INDEX_GC_KEEP=5
CKG_REPO_DIR=/home/<vm-user>/procol-ckg
